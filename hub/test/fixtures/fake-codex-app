          const item = { type: "mcpToolCall", id: "mcp-1", server: "crosstalk", tool: "read_chat", arguments: { chat: "r-test" } };
          out({ method: "item/started", params: { threadId: tid, turnId: id, item } });
          out({ method: "item/completed", params: { threadId: tid, turnId: id, item: { ...item, status: "completed", result: { isError: true, content: [{ type: "text", text: "Tool returned useful context " + "x".repeat(30000) }] } } } });
        }
        if (text.includes("V2_HELPER")) out({ method: "item/completed", params: { threadId: tid, turnId: id, item: { type: "subAgentActivity", id: "v2", kind: "started", agentThreadId: "helper-1", agentPath: "/root/helper" } } });
        // V2_MESSAGE_ROOT: a reply that uses Codex's newer helpers (multi_agent_v2, 0.160), in the order Codex sent it in
        // the stuck reply. The agent starts two helpers (a "started" subAgentActivity on its own thread; no thread/started
        // and no collabAgentToolCall for them) and waits; each helper tells it what it found with send_message to /root,
        // which Codex reports on the helper's own thread as an "interacted" subAgentActivity naming the agent it messaged:
        // agentThreadId is the chat's own thread. The helpers' messages reach the agent inside its turn (no turn of their
        // own on its thread). The agent gives one helper a follow-up (a second turn on that helper's thread), searches the
        // web, and writes its answer after the helpers' turns have ended; the last helper's "completed" activity reaches the
        // chat's thread after the reply's turn ended.
        if (text.includes("V2_MESSAGE_ROOT")) {
          const helpers = [
            { thread: "th-helper-a", turn: "tu-helper-a", path: "/root/helper_a" },
            { thread: "th-helper-b", turn: "tu-helper-b", path: "/root/helper_b" },
          ];
          const both = (threadId: string, turnId: string, item: unknown) => {
            out({ method: "item/started", params: { threadId, turnId, item } });
            out({ method: "item/completed", params: { threadId, turnId, item } });
          };
          const turnEvent = (method: string, threadId: string, turnId: string, status: string) => out({ method, params: { threadId, turn: { id: turnId, items: [], status } } });
          const wait = (status: string) => ({ type: "collabAgentToolCall", id: `wait-${n}`, tool: "wait", status, senderThreadId: tid, receiverThreadIds: [], prompt: null, model: null, reasoningEffort: null, agentsStates: {} });
          const pause = (ms: number) => new Promise((r) => setTimeout(r, ms));
          void (async () => {
            await pause(5); // the turn/start answer goes first
            turnEvent("turn/started", tid, id, "inProgress");
            out({ method: "item/agentMessage/delta", params: { threadId: tid, turnId: id, itemId: `m0-${n}`, delta: "Asking two helpers." } });
            for (const h of helpers) {
              both(tid, id, { type: "subAgentActivity", id: `spawn-${h.thread}`, kind: "started", agentThreadId: h.thread, agentPath: h.path });
              turnEvent("turn/started", h.thread, h.turn, "inProgress");
              out({ method: "item/agentMessage/delta", params: { threadId: h.thread, turnId: h.turn, itemId: `hm-${h.thread}`, delta: "helper text" } });
            }
            out({ method: "item/started", params: { threadId: tid, turnId: id, item: wait("inProgress") } });
            await pause(5);
            for (const h of helpers) both(h.thread, h.turn, { type: "subAgentActivity", id: `msg-${h.thread}`, kind: "interacted", agentThreadId: tid, agentPath: "/root" });
            out({ method: "item/completed", params: { threadId: tid, turnId: id, item: wait("completed") } });
            // A follow-up for the first helper: its first turn ends, and a turn of its own for the follow-up runs and ends.
            both(tid, id, { type: "subAgentActivity", id: `followup-${n}`, kind: "interacted", agentThreadId: helpers[0].thread, agentPath: helpers[0].path });
            turnEvent("turn/completed", helpers[0].thread, helpers[0].turn, "completed");
            turnEvent("turn/started", helpers[0].thread, `${helpers[0].turn}-2`, "inProgress");
            out({ method: "item/agentMessage/delta", params: { threadId: helpers[0].thread, turnId: `${helpers[0].turn}-2`, itemId: "hm-2", delta: "more helper text" } });
            turnEvent("turn/completed", helpers[0].thread, `${helpers[0].turn}-2`, "completed");
            await pause(5);
            both(tid, id, { type: "webSearch", id: `ws-${n}`, query: "after the helpers", action: null });
            turnEvent("turn/completed", helpers[1].thread, helpers[1].turn, "completed");
            await pause(5);
            out({ method: "item/agentMessage/delta", params: { threadId: tid, turnId: id, itemId: `m1-${n}`, delta: "Done." } });
            both(tid, id, { type: "subAgentActivity", id: `subagent-completed-${helpers[1].turn}`, kind: "completed", agentThreadId: helpers[1].thread, agentPath: helpers[1].path });
            out({ method: "item/completed", params: { threadId: tid, turnId: id, item: { type: "agentMessage", id: `m1-${n}`, text: "Done.", phase: null } } });
            turnEvent("turn/completed", tid, id, "completed");
            await pause(5);
            both(tid, id, { type: "subAgentActivity", id: `subagent-completed-${helpers[0].turn}-2`, kind: "completed", agentThreadId: helpers[0].thread, agentPath: helpers[0].path });
          })();
          break;
        }
        // ASK_RUN:<command>[@<cwd>], ASK_NET:<command> (network access for it), ASK_STDIN:<command> (input into a
        // terminal that's running), ASK_EDIT:<add|update|delete|move>:<path> (a file change).
        const run = /ASK_(RUN|NET|STDIN):([^\s@]+)(?:@(\S+))?/.exec(text);
        const edit = /ASK_EDIT:(\w+):(\S+)/.exec(text);
        if (run || edit) {
          const asked = run
            ? ask("item/commandExecution/requestApproval", { threadId: tid, turnId: id, itemId: `cmd-${n}`, kind: run[1] === "STDIN" ? "writeStdin" : "command", environmentId: null, command: run[2], cwd: run[3] ?? "/tmp", ...(run[1] === "NET" ? { networkApprovalContext: { host: "example.com", protocol: "https" } } : {}) })
            : (() => {
                const kind = edit![1] === "move" ? { type: "update", move_path: `${edit![2]}.moved` } : edit![1] === "update" ? { type: "update", move_path: null } : { type: edit![1] };
                const item = { type: "fileChange", id: `fc-${n}`, changes: [{ path: edit![2], kind, diff: "" }], status: "inProgress" };
                out({ method: "item/started", params: { threadId: tid, turnId: id, item } });
                return ask("item/fileChange/requestApproval", { threadId: tid, turnId: id, itemId: item.id });
              })();
          void asked.then((r) => {
            out({ method: "item/agentMessage/delta", params: { threadId: tid, turnId: id, itemId: "i1", delta: `Decision: ${r.decision}` } });
            out({ method: "turn/completed", params: { threadId: tid, turn: { id, status: "completed" } } });
          });
          break;
        }
        // BACKGROUND_TERMINAL: a command (a dev server) that keeps running after its turn ends; STOP_TERMINAL: it ends.
        if (text.includes("BACKGROUND_TERMINAL") || text.includes("STOP_TERMINAL")) {
          const item = { type: "commandExecution", id: "cmd-bg", command: "bun run dev", cwd: "/tmp", processId: "p-1", source: "unifiedExecStartup", status: "inProgress", commandActions: [] };
          if (text.includes("STOP_TERMINAL")) out({ method: "item/completed", params: { threadId: tid, turnId: id, item: { ...item, status: "completed", exitCode: 0 } } });
          else out({ method: "item/started", params: { threadId: tid, turnId: id, item } });
          out({ method: "item/agentMessage/delta", params: { threadId: tid, turnId: id, itemId: "i1", delta: "Done." } });
          out({ method: "turn/completed", params: { threadId: tid, turn: { id, status: "completed" } } });
          break;
        }
        if (text.includes("LONG_STEP")) {
          const item = { type: "commandExecution", id: `cmd-${n}`, command: "sleep 600", cwd: "/tmp", status: "inProgress", commandActions: [] };
          out({ method: "item/started", params: { threadId: tid, turnId: id, item } });
          long.set(id, { tid, pending: [], taken: [] });
          break;
        }
        const spawn = /SPAWN:([^:\s]*):([^:\s]*)/.exec(text);
        if (spawn) {
          out({ method: "item/started", params: { threadId: tid, turnId: id, item: { type: "collabAgentToolCall", id: "c1", tool: "spawnAgent", status: "inProgress", prompt: "Check the tests", model: spawn[1] || null, reasoningEffort: spawn[2] || null } } });
          // Finished, it says what the helper runs on (FAKE_CODEX_SPAWN_DONE_EFFORT: other than what the start said).
          out({ method: "item/completed", params: { threadId: tid, turnId: id, item: { type: "collabAgentToolCall", id: "c1", tool: "spawnAgent", status: "completed", prompt: "Check the tests", model: spawn[1] || null, reasoningEffort: process.env.FAKE_CODEX_SPAWN_DONE_EFFORT ?? (spawn[2] || null) } } });
        }
        if (mark && !existsSync(mark)) {
          writeFileSync(mark, String(process.pid));
          process.on("SIGTERM", () => {});
          frozen = true;
          break;
        }
        out({ method: "item/agentMessage/delta", params: { threadId: tid, turnId: id, itemId: "i1", delta: text.startsWith("(Crosstalk stopped the step") ? "Answering your message now." : "Done." } });
        out({ method: "turn/completed", params: { threadId: tid, turn: { id, status: "completed" } } });
        break;
      }
      case "turn/steer": {
        const waiting = waitingTurns.get(m.params.expectedTurnId);
        if (waiting) {
          out({ id: m.id, result: { turnId: m.params.expectedTurnId } });
          waiting.taken.push(userItem(m.params.clientUserMessageId ?? null, m.params.input?.[0]?.text ?? ""));
          const turnId = m.params.expectedTurnId;
          // It reads what was steered in at its next step, a moment after the last message.
          clearTimeout(waiting.timer);
          waiting.timer = setTimeout(() => {
            waitingTurns.delete(turnId);
            for (const item of waiting.taken) {
              out({ method: "item/started", params: { threadId: waiting.tid, turnId, item } });
              out({ method: "item/completed", params: { threadId: waiting.tid, turnId, item } });
            }
            out({ method: "item/agentMessage/delta", params: { threadId: waiting.tid, turnId, itemId: "i2", delta: "Got your answer." } });
            out({ method: "turn/completed", params: { threadId: waiting.tid, turn: { id: turnId, status: "completed" } } });
          }, 60);
          break;
        }
        const turn = long.get(m.params.expectedTurnId);
        if (!turn) {
          out({ id: m.id, error: { code: -32600, message: "no active turn to steer" } });
          break;
        }
        turn.pending.push({ clientId: m.params.clientUserMessageId ?? null, text: m.params.input?.[0]?.text ?? "" });
        out({ id: m.id, result: { turnId: m.params.expectedTurnId } });
        if (process.env.FAKE_CODEX_FAIL_ON_STEER === "1") {
          long.delete(m.params.expectedTurnId);
          out({ method: "turn/completed", params: { threadId: m.params.threadId, turn: { id: m.params.expectedTurnId, status: "failed", error: { message: "The model had a problem.", codexErrorInfo: "other", additionalDetails: null, misalignment: null } } } });
        }
        break;
      }
      case "turn/interrupt": {
        out({ id: m.id, result: {} });
        const turn = long.get(m.params.turnId);
        if (turn && process.env.FAKE_CODEX_STUCK_INTERRUPT === "1") break;
        if (turn && process.env.FAKE_CODEX_TAKE_ON_INTERRUPT === "1") {
          for (const p of turn.pending.splice(0)) {
            const item = userItem(p.clientId, p.text);
            out({ method: "item/started", params: { threadId: turn.tid, turnId: m.params.turnId, item } });
            out({ method: "item/completed", params: { threadId: turn.tid, turnId: m.params.turnId, item } });
            turn.taken.push(item);
          }
        }
        long.delete(m.params.turnId);
        const ended = () => out({ method: "turn/completed", params: { threadId: m.params.threadId, turn: { id: m.params.turnId, status: "interrupted", items: turn?.taken ?? [], itemsView: "summary" } } });
        if (process.env.FAKE_CODEX_STOP_MS) setTimeout(ended, Number(process.env.FAKE_CODEX_STOP_MS));
        else ended();
        break;
      }
      default:
        if (m.id !== undefined) out({ id: m.id, result: {} });
    }
  }
}
