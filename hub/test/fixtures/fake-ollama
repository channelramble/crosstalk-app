#!/usr/bin/env bun
// Stand-in for the `ollama` program in the Local models tests: `ollama serve` listens on OLLAMA_HOST (127.0.0.1:11434 by
// default) and answers /api/version, /v1/models, /api/tags and /api/ps like Ollama, from the models in its settings. No
// model ever runs and nothing is downloaded. Its settings are a JSON file beside it (<its path>.json): Local models
// starts servers with a short environment. `log`: a file each start is noted in (one JSON line: pid, cwd, host, the
// environment's names, the runner's pid); `runner`: it starts a child process the way Ollama starts a model runner (in
// its process group; it isn't ended when the server is, so a test sees the whole group end); `fail: "bind"`: it stops
// at once as Ollama does when its port is taken; `startMs`: it waits that long before it listens. It ends by itself, with
// its runner, once whoever started it has gone.
import { spawn } from "node:child_process";
import { appendFileSync, readFileSync } from "node:fs";

const settings: { log?: string; runner?: boolean; fail?: "bind"; startMs?: number; models?: string[] } = (() => {
  try {
    return JSON.parse(readFileSync(`${process.argv[1]}.json`, "utf8"));
  } catch {
    return {};
  }
})();
const args = process.argv.slice(2);
const t = () => new Date().toISOString();

if (args[0] === "--version" || args[0] === "-v") {
  console.log("ollama version is 0.12.0");
  process.exit(0);
}
if (args[0] !== "serve") {
  console.error(`Error: unknown command "${args[0] ?? ""}" for "ollama"`);
  process.exit(1);
}

const [host, portText] = (process.env.OLLAMA_HOST ?? "127.0.0.1:11434").split(":");
const port = Number(portText ?? 11434);
if (settings.fail === "bind") {
  console.error(`Error: listen tcp ${host}:${port}: bind: address already in use`);
  process.exit(1);
}
let runner: number | null = null;
if (settings.runner) {
  const child = spawn(process.execPath, ["-e", "setInterval(() => {}, 60_000)"], { stdio: "ignore" });
  runner = child.pid ?? null;
}
// Local models runs it in a process group of its own, which nothing ends when a test run is killed before its afterEach
// (hub/test/standins.ts): once whoever started it is gone, so is this, and its runner (which outlives the server
// otherwise, as a test needs).
const starter = process.ppid;
setInterval(() => {
  if (process.ppid === starter) return;
  try {
    if (runner) process.kill(runner, "SIGKILL");
  } catch {
    // Ended already.
  }
  process.exit(0);
}, 500).unref();
if (settings.log) appendFileSync(settings.log, JSON.stringify({ pid: process.pid, cwd: process.cwd(), host: process.env.OLLAMA_HOST ?? null, env: Object.keys(process.env).sort(), runner }) + "\n");
if (settings.startMs) await Bun.sleep(settings.startMs);
const models = settings.models ?? ["qwen3:8b"];
console.error(`time=${t()} level=INFO source=routes.go msg="Listening on ${host}:${port} (version 0.12.0)"`);
Bun.serve({
  hostname: host,
  port,
  fetch(req) {
    const path = new URL(req.url).pathname;
    if (path === "/api/version") return Response.json({ version: "0.12.0" });
    if (path === "/v1/models") return Response.json({ object: "list", data: models.map((id) => ({ id, object: "model", owned_by: "library" })) });
    if (path === "/api/tags") return Response.json({ models: models.map((name) => ({ name, model: name, size: 5_200_000_000 })) });
    if (path === "/api/ps") return Response.json({ models: [] });
    if (req.method === "POST") return Response.json({ error: "missing fields" }, { status: 400 });
    return new Response("404 page not found", { status: 404 });
  },
});
for (const signal of ["SIGTERM", "SIGINT"] as const) process.on(signal, () => process.exit(0));
