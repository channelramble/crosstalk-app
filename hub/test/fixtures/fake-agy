#!/usr/bin/env bun
// Stand-in for Antigravity CLI's headless stream-json mode. The final `result` event matches the real CLI's
// and step_update events match the real CLI's output (captured from agy 1.2.16).
import { appendFileSync } from "node:fs";
if (process.env.FAKE_AGY_ARGS_OUT) appendFileSync(process.env.FAKE_AGY_ARGS_OUT, JSON.stringify(process.argv.slice(2)) + "\n");
if (process.env.FAKE_AGY_SIGNED_OUT) {
  console.error("Authentication required. Please visit the URL to log in:");
  console.log(JSON.stringify({ event: "result", result: { conversation_id: "", status: "ERROR", response: "", error: "authentication failed or timed out", duration_seconds: 0, num_turns: 0, usage: { input_tokens: 0, output_tokens: 0, thinking_tokens: 0, cache_read_tokens: 0, total_tokens: 0 } } }));
  process.exit(0);
}
let n = 0;
for await (const line of console) {
  const msg = JSON.parse(line);
  n++;
  const out = (o) => console.log(JSON.stringify(o));
  if (process.env.FAKE_AGY_SLOW) await Bun.sleep(Number(process.env.FAKE_AGY_SLOW));
  if (process.env.FAKE_AGY_DENY && (process.env.FAKE_AGY_DENY === "always" || !msg.message.content.startsWith("(Crosstalk)"))) {
    // Real shape (agy 1.2.16, --mode accept-edits): the command step errors, the result has no reply and lists denied_actions.
    out({ event: "step_update", step_update: { conversation_id: "conv-1", step_index: 2, state: "ACTIVE", step_type: "tool", tool_name: "run_command", tool_info: { name: "run_command", parameters: { CommandLine: "ls" } } } });
    out({ event: "step_update", step_update: { conversation_id: "conv-1", step_index: 2, state: "ERROR", step_type: "tool", tool_name: "run_command", tool_info: { name: "run_command", parameters: { CommandLine: "ls" }, error: { type: "TOOL_ERROR", message: "permission check failed for unsandboxed \"ls\"" } } } });
    console.error('jetski: no output produced — a tool required the "command" permission that headless mode cannot prompt for, so it was auto-denied.');
    out({ event: "result", result: { conversation_id: "conv-1", status: "SUCCESS", response: "", num_turns: 1, usage: { input_tokens: 100, output_tokens: 10, thinking_tokens: 0, cache_read_tokens: 0, total_tokens: 110 }, denied_actions: [{ action: "command", display_name: "RunCommand" }] } });
    continue;
  }
  if (process.env.FAKE_AGY_DENY === "then-silent") {
    // The follow-up after a denial answers with nothing and lists no denied actions of its own.
    out({ event: "result", result: { conversation_id: "conv-1", status: "SUCCESS", response: "", num_turns: 1, usage: { input_tokens: 5, output_tokens: 0, thinking_tokens: 0, cache_read_tokens: 0, total_tokens: 5 }, denied_actions: [] } });
    continue;
  }
  if (process.env.FAKE_AGY_QUIET) {
    out({ event: "result", result: { conversation_id: "conv-1", status: "SUCCESS", response: `Quiet reply ${n} to: ${msg.message.content.slice(-20)}`, error: "", duration_seconds: 1, num_turns: 1, usage: { input_tokens: 10, output_tokens: 5, thinking_tokens: 2, cache_read_tokens: 1, total_tokens: 18 } } });
    continue;
  }
  const step = (o) => out({ event: "step_update", step_update: { conversation_id: "conv-1", ...o } });
  step({ step_index: 0, state: "DONE", step_type: "user_input" });
  step({ step_index: 1, state: "DONE", step_type: "agent_response", duration_seconds: 2, usage: { input_tokens: 50, output_tokens: 10 } });
  step({ step_index: 2, state: "ACTIVE", step_type: "tool", tool_name: "run_command", tool_info: { name: "run_command", parameters: { CommandLine: "ls" } } });
  step({ step_index: 2, state: "DONE", step_type: "tool", tool_name: "run_command", duration_seconds: 0.05, tool_info: { name: "run_command", parameters: { CommandLine: "ls" }, output: "README.md\r\n" } });
  step({ step_index: 3, state: "ACTIVE", step_type: "agent_response", text_delta: "Hello " });
  step({ step_index: 3, state: "DONE", step_type: "agent_response", text_delta: `from turn ${n}.`, duration_seconds: 1 });
  out({ event: "mystery", foo: 1 });
  out({ event: "result", result: { conversation_id: "conv-1", status: "SUCCESS", response: `Hello from turn ${n}.`, error: "", duration_seconds: 1, num_turns: 1, usage: { input_tokens: 100, output_tokens: 20, thinking_tokens: 5, cache_read_tokens: 40, total_tokens: 165 } } });
}
