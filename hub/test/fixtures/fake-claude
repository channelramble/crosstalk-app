#!/usr/bin/env bun
// Stand-in for `claude -p --input-format stream-json --output-format stream-json` used by driver tests.
// Emits the same event shapes Claude Code's headless mode documents.
import { appendFileSync, existsSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

// ---- Sign-in, scripted (never Claude Code's real one). FAKE_CLAUDE_AUTH_FILE holds the shared sign-in's state, the way
// the keychain item holds Claude Code's: "in" (signed in, the default), or "out" (cleared, as Claude Code clears it when
// the server refuses a refresh token). `auth status` reads it; `auth login` writes "in" when it's given the right code.
const authFile = process.env.FAKE_CLAUDE_AUTH_FILE;
const authState = () => (authFile && existsSync(authFile) ? readFileSync(authFile, "utf8").trim() : "in");
if (process.argv[2] === "--version") {
  process.stdout.write("2.1.316 (Claude Code)\n");
  process.exit(0);
}
if (process.argv[2] === "auth" && process.argv[3] === "status") {
  // As Claude Code 2.1.316 prints it (JSON unless --text), exiting 0 when signed in and 1 when not.
  const loggedIn = authState() === "in";
  const status = loggedIn
    ? { loggedIn: true, authMethod: "claude.ai", apiProvider: "firstParty", email: "person@example.com", orgId: "org-test", orgName: "Test org", subscriptionType: "max" }
    : { loggedIn: false, authMethod: "none", apiProvider: "firstParty" };
  process.stdout.write(JSON.stringify(status, null, 2) + "\n");
  process.exit(loggedIn ? 0 : 1);
}
if (process.argv[2] === "auth" && process.argv[3] === "login") {
  // As `claude auth login` (2.1.289-2.1.316) does it: the link (an OSC 8 link on a terminal), then it waits for the
  // code#state the callback page shows, a line at a time. FAKE_CLAUDE_LOGIN_CODE: the code part the page shows
  // (default "fake-auth-code-123456"); FAKE_CLAUDE_LOGIN_STATE_OUT: where the test finds the state; FAKE_CLAUDE_LOGIN_ECHO=1:
  // what's typed comes back on the screen, as a terminal that echoes shows it. A wrong code ends it (exit 1).
  // FAKE_CLAUDE_LOGIN_ENV_OUT: what it was started with that decides where a browser opens (it must open none).
  if (process.env.FAKE_CLAUDE_LOGIN_ENV_OUT) writeFileSync(process.env.FAKE_CLAUDE_LOGIN_ENV_OUT, JSON.stringify({ BROWSER: process.env.BROWSER ?? null, stdinTTY: !!process.stdin.isTTY }));
  const state = [...crypto.getRandomValues(new Uint8Array(16))].map((b) => b.toString(16).padStart(2, "0")).join("");
  if (process.env.FAKE_CLAUDE_LOGIN_STATE_OUT) writeFileSync(process.env.FAKE_CLAUDE_LOGIN_STATE_OUT, state);
  const url = `https://claude.com/cai/oauth/authorize?code=true&client_id=fake-client&response_type=code&redirect_uri=https%3A%2F%2Fplatform.claude.com%2Foauth%2Fcode%2Fcallback&scope=user%3Ainference&code_challenge=fakechallenge&code_challenge_method=S256&state=${state}`;
  const link = process.stdout.isTTY ? `\x1b]8;;${url}\x07\x1b[34m${url}\x1b[39m\x1b]8;;\x07` : url;
  process.stdout.write("Opening browser to sign in…\n");
  process.stdout.write(`If the browser didn't open, visit: ${link}\n`);
  process.stdout.write("Paste code here if prompted > ");
  const expected = process.env.FAKE_CLAUDE_LOGIN_CODE || "fake-auth-code-123456";
  for await (const line of console) {
    if (process.env.FAKE_CLAUDE_LOGIN_ECHO === "1") process.stdout.write(`${line}\r\n`);
    const [code, st] = line.trim().split("#");
    if (!code || !st) {
      process.stderr.write("Invalid code. Please make sure the full code was copied.\n");
      continue;
    }
    if (code !== expected || st !== state) {
      // FAKE_CLAUDE_LOGIN_SAY_CODE=1: a sign-in that repeats what it was given in its failure (Crosstalk must not).
      process.stderr.write(process.env.FAKE_CLAUDE_LOGIN_SAY_CODE === "1" ? `Login failed: couldn't exchange ${line.trim()}\n` : "Login failed: Request failed with status code 400\n");
      process.exit(1);
    }
    if (authFile) writeFileSync(authFile, "in");
    process.stdout.write("Login successful.\n");
    process.exit(0);
  }
  process.exit(1);
}

const argsOut = process.env.FAKE_CLAUDE_ARGS_OUT;
if (argsOut) appendFileSync(argsOut, JSON.stringify(process.argv.slice(2)) + "\n");
const envOut = process.env.FAKE_CLAUDE_ENV_OUT;
if (envOut) appendFileSync(envOut, JSON.stringify(Object.fromEntries(Object.entries(process.env).filter(([k]) => /^(CLAUDE_CODE_|CROSSTALK_)/.test(k)))) + "\n");
// FAKE_CLAUDE_CWD_OUT: the folder each start runs in, a JSON line per start.
if (process.env.FAKE_CLAUDE_CWD_OUT) appendFileSync(process.env.FAKE_CLAUDE_CWD_OUT, JSON.stringify(process.cwd()) + "\n");
// FAKE_CLAUDE_RUN_MODELS="claude-opus-5,": the model each start of this fake comes up on, in turn (counted by the lines
// FAKE_CLAUDE_ARGS_OUT holds; an empty entry comes up on the model it was started on), as Claude Code can when it puts
// another model in place of the one it was asked for. FAKE_CLAUDE_RUN_LIMITS="1": the starts whose every reply hits the
// plan limit, as PLAN_LIMIT does.
const startNo = argsOut && existsSync(argsOut) ? readFileSync(argsOut, "utf8").trim().split("\n").length : 1;
const runModel = (process.env.FAKE_CLAUDE_RUN_MODELS ?? "").split(",")[startNo - 1] || null;
const limitRun = (process.env.FAKE_CLAUDE_RUN_LIMITS ?? "").split(",").includes(String(startNo));
// FAKE_CLAUDE_STALE_STARTS="1": the starts that hold a sign-in gone stale (counted the same way): every reply of theirs
// fails before any request, as Claude Code 2.1.289 chats can. A fresh start reads the sign-in as
// FAKE_CLAUDE_AUTH_FILE has it: "out" fails the same way.
const staleRun = (process.env.FAKE_CLAUDE_STALE_STARTS ?? "").split(",").includes(String(startNo));
// FAKE_CLAUDE_STALE_MIDWAY_STARTS="1": the starts whose sign-in can't be renewed partway through a reply, as on an API
// call between two steps of a long one: it runs a command (`git push origin main`), says so, and then fails as stale.
const staleMidwayRun = (process.env.FAKE_CLAUDE_STALE_MIDWAY_STARTS ?? "").split(",").includes(String(startNo));
const modelIdx = process.argv.indexOf("--model");
const model = runModel || process.env.FAKE_CLAUDE_INIT_MODEL || (modelIdx > 0 && process.argv[modelIdx + 1] !== "default" ? process.argv[modelIdx + 1] : "claude-test");

const resumeIdx = process.argv.indexOf("--resume");
const resumed = resumeIdx > 0 ? process.argv[resumeIdx + 1] : null;
// --fork-session continues in a new session; --resume-session-at ends the copy at that entry.
const forking = process.argv.includes("--fork-session");
const atIdx = process.argv.indexOf("--resume-session-at");
const sessionId = forking ? process.env.FAKE_CLAUDE_FORK_ID || "99999999-8888-7777-6666-555555555555" : resumed ?? "11111111-2222-3333-4444-555555555555";
// FAKE_CLAUDE_PROJECTS: like Claude Code, find a resumed session in this folder's project directory (and write a fork there).
const projects = process.env.FAKE_CLAUDE_PROJECTS;
if (projects && resumed) {
  const dir = join(projects, process.cwd().replace(/[^a-zA-Z0-9]/g, "-"));
  const from = join(dir, `${resumed}.jsonl`);
  if (!existsSync(from)) {
    process.stderr.write(`No conversation found with session ID: ${resumed}\n`);
    process.exit(1);
  }
  if (forking) {
    const lines = readFileSync(from, "utf8").split("\n").filter(Boolean);
    const at = atIdx > 0 ? lines.findIndex((l) => JSON.parse(l).uuid === process.argv[atIdx + 1]) : -1;
    // Like Claude Code, --resume-session-at finds only messages on the conversation's current path (from its newest
    // entry back): one a rewind left behind, or a missing one, is an error it exits on.
    if (atIdx > 0) {
      const entries = lines.map((l) => JSON.parse(l)).filter((e) => typeof e.uuid === "string" && "parentUuid" in e);
      const byId = new Map(entries.map((e) => [e.uuid, e]));
      const path = new Set<string>();
      for (let e = entries.at(-1); e; e = e.parentUuid ? byId.get(e.parentUuid) : undefined) path.add(e.uuid);
      if (!path.has(process.argv[atIdx + 1])) {
        const msg = `No message found with message.uuid of: ${process.argv[atIdx + 1]}`;
        process.stderr.write(msg + "\n");
        process.stdout.write(JSON.stringify({ type: "result", subtype: "error_during_execution", is_error: true, num_turns: 0, session_id: sessionId, errors: [msg] }) + "\n");
        process.exit(1);
      }
    }
    writeFileSync(join(dir, `${sessionId}.jsonl`), (at >= 0 ? lines.slice(0, at + 1) : lines).map((l) => `${JSON.stringify({ ...JSON.parse(l), sessionId })}\n`).join(""));
  }
}
// FAKE_CLAUDE_TOTALS="0.5,0.9": the total_cost_usd of each result that reports one, in turn, instead of the constants below.
// Claude Code reports a running total per process, so a real run's are cumulative; a new process starts its list again.
const totals = (process.env.FAKE_CLAUDE_TOTALS ?? "").split(",").filter(Boolean).map(Number);
// FAKE_CLAUDE_TRANSCRIPT: the session as Claude Code keeps it, a JSON line per message ({ role, text, model, start }: the
// model that wrote it and which start of the fake it was). Like Claude Code, a message is written in as it's taken up
// (a turn's own, a queued one, a background task's <task-notification>), and a resumed start whose session ends on a line
// nothing answered closes it with Claude Code's own "No response requested." when its next input comes: that line is
// never answered then.
const transcript = process.env.FAKE_CLAUDE_TRANSCRIPT;
const record = (role: "user" | "assistant", text: string, by: string | null) => {
  if (transcript) appendFileSync(transcript, JSON.stringify({ role, text, model: role === "assistant" ? by : null, start: startNo }) + "\n");
};
let unansweredChecked = !resumed;
const takeUp = (text: string) => {
  if (!unansweredChecked) {
    unansweredChecked = true;
    const last = transcript && existsSync(transcript) ? readFileSync(transcript, "utf8").trim().split("\n").filter(Boolean).at(-1) : undefined;
    if (last && JSON.parse(last).role === "user") record("assistant", "No response requested.", "<synthetic>");
  }
  record("user", text, null);
};
const out = (o: any) => {
  if (o.type === "result" && typeof o.total_cost_usd === "number" && totals.length) o.total_cost_usd = totals.shift();
  process.stdout.write(JSON.stringify(o) + "\n");
  if (o.type === "result") record("assistant", String(o.result ?? ""), model);
};
let initSent = false;
let pendingInterrupt: (() => void) | null = null;
// FAKE_CLAUDE_QUEUE=1: like Claude Code, a message sent while a turn runs waits in a queue and runs after it, a plain
// interrupt keeps it queued, interrupt with send_now (interrupt_send_now_v1, unless FAKE_CLAUDE_NO_SEND_NOW) stops the
// turn for it, and interrupt with cancel_queued (interrupt_cancel_queued_v1, unless FAKE_CLAUDE_NO_CANCEL_QUEUED) empties
// the queue and lists what it took under `cancelled`. LONG_STEP starts a command that runs until interrupted, SLOW:<ms> a
// reply that takes that long. FAKE_CLAUDE_TAKE_IN=1: the running turn takes a queued message in at once (it isn't queued any more, and isn't
// answered unless asked again). FAKE_CLAUDE_STOP_MS: how long a stopped LONG_STEP takes to wind down.
const queueMode = process.env.FAKE_CLAUDE_QUEUE === "1";
const queue: { uuid: string; text: string }[] = [];
let busy = false;
let stopLong: (() => void) | null = null;
const capabilities = ["interrupt_receipt_v1", ...(queueMode && !process.env.FAKE_CLAUDE_NO_SEND_NOW ? ["interrupt_send_now_v1"] : []), ...(queueMode && !process.env.FAKE_CLAUDE_NO_CANCEL_QUEUED ? ["interrupt_cancel_queued_v1"] : [])];
// FAKE_CLAUDE_WAKE_MS: how long the first words of a turn Claude Code starts by itself take (a background task's report,
// a message queued behind a reply that ended): its request has gone out, and the API is reading the conversation. Set,
// queued messages wait for it too.
const wakeMs = Number(process.env.FAKE_CLAUDE_WAKE_MS ?? 600);
// Like Claude Code with CLAUDE_CODE_EMIT_SESSION_STATE_EVENTS (the driver always sets it), it says when it starts and
// stops working (system/session_state_changed): "running" as it takes something up with nothing else running (a message,
// a background task's report), "idle" once it has nothing left to do, never in between two turns it runs back to back
// (a reply, then the report it hadn't taken in). FAKE_CLAUDE_NO_STATE=1: a Claude Code that never says.
const saysState = process.env.CLAUDE_CODE_EMIT_SESSION_STATE_EVENTS === "1" && process.env.FAKE_CLAUDE_NO_STATE !== "1";
let working = 0;
const sayState = (s: "running" | "idle") => saysState && out({ type: "system", subtype: "session_state_changed", state: s, uuid: crypto.randomUUID(), session_id: sessionId });
const begin = () => {
  if (working++ === 0) sayState("running");
};
const end = () => {
  if (--working === 0) sayState("idle");
};

const delta = (text: string) => out({ type: "stream_event", parent_tool_use_id: null, session_id: sessionId, event: { type: "content_block_delta", index: 0, delta: { type: "text_delta", text } } });
const msgStart = () => out({ type: "stream_event", parent_tool_use_id: null, session_id: sessionId, event: { type: "message_start", message: { id: "msg_" + Math.random() } } });

// ---- A background job. BACKGROUND_JOB: the reply starts the
// test suite with Bash's run_in_background (a local_bash task) and ends while it runs. The job finishes once the file
// FAKE_CLAUDE_JOB_DONE names exists (else after 200 ms). Then, as Claude Code does: task_updated and task_notification
// go out, its <task-notification> is written into the session as Claude Code takes it up, and after FAKE_CLAUDE_WAKE_MS
// (default 600: longer than the hub's 300 ms batching of task reports) Claude Code answers it in a turn of its own,
// carrying on with the plan. FAKE_CLAUDE_NO_WAKE=1: the job is reported and nothing answers it (Claude Code takes the
// report in without a word: "running", then "idle", as it does one that asks nothing). Within the reply instead:
// BACKGROUND_JOB FOLDED, the job finishes during the reply's next step (reading the plan), and the request after that
// step carries its report (Claude Code attaches what came in before it put the request together); BACKGROUND_JOB LATE,
// it finishes while the reply's last request is already on its way, which hasn't it, so Claude Code answers it in a turn
// of its own after the reply. SLOW:<ms>: that step (or that request) takes so long.
const JOB_OUTPUT = "/private/tmp/claude-501/fake-project/fake-session/tasks/job1.output";
const JOB_SUMMARY = 'Background command "Run the test suite" completed (exit code 0)';
const CARRY_ON = "The test suite passed. Carrying on with the plan: fixing the flaky test next.";
function reportJob() {
  out({ type: "system", subtype: "task_updated", task_id: "job1", patch: { status: "completed", end_time: Date.now() }, session_id: sessionId });
  out({ type: "system", subtype: "task_notification", task_id: "job1", tool_use_id: "toolu_job", status: "completed", output_file: JOB_OUTPUT, summary: JOB_SUMMARY, session_id: sessionId });
}
async function finishJob() {
  const done = process.env.FAKE_CLAUDE_JOB_DONE;
  if (done) while (!existsSync(done)) await Bun.sleep(20);
  else await Bun.sleep(200);
  reportJob();
  if (process.env.FAKE_CLAUDE_NO_WAKE !== "1") return answerJob();
  begin();
  end();
}
/**
 * Claude Code takes the job's report up, writes it into the session, and answers it once the API's first words are back.
 * FAKE_CLAUDE_WAKE_LIMIT=1: the 5-hour window ran out as the job finished, so that request is refused before any words,
 * as Claude Code reports a plan limit (a rejected rate_limit_event, its synthetic error reply, a result with the API's
 * 429). FAKE_CLAUDE_WAKE_STREAM_MS: how long its answer takes after its first event (message_start), so the hub can stop
 * it before it has written or done anything.
 */
async function answerJob() {
  begin();
  takeUp(`<task-notification>\n<task-id>job1</task-id>\n<tool-use-id>toolu_job</tool-use-id>\n<output-file>${JOB_OUTPUT}</output-file>\n<status>completed</status>\n<summary>${JOB_SUMMARY}</summary>\n</task-notification>`);
  await Bun.sleep(wakeMs);
  if (process.env.FAKE_CLAUDE_WAKE_LIMIT === "1") {
    const said = "You've hit your session limit · resets 11pm";
    out({ type: "rate_limit_event", session_id: sessionId, rate_limit_info: { status: "rejected", utilization: 1, resetsAt: Math.floor(Date.now() / 1000) + 1800, rateLimitType: "five_hour" } });
    out({ type: "assistant", parent_tool_use_id: null, session_id: sessionId, error: "rate_limit", message: { model: "<synthetic>", content: [{ type: "text", text: said }] } });
    out({ type: "result", subtype: "success", is_error: true, api_error_status: 429, api_error: null, result: `${said} · progress saved`, num_turns: 1, session_id: sessionId, usage: { input_tokens: 10, output_tokens: 0 }, total_cost_usd: 0 });
    end();
    return;
  }
  msgStart();
  // Its answer takes FAKE_CLAUDE_WAKE_STREAM_MS after the first event. Interrupted meanwhile, it stops there, as Claude
  // Code does: the model wrote nothing and ran nothing, the answer is never written into the session, and the result says
  // it was interrupted.
  const stream = Number(process.env.FAKE_CLAUDE_WAKE_STREAM_MS ?? 0);
  if (stream > 0) {
    const stopped = await new Promise<boolean>((res) => {
      const timer = setTimeout(() => {
        pendingInterrupt = null;
        res(false);
      }, stream);
      pendingInterrupt = () => {
        clearTimeout(timer);
        res(true);
      };
    });
    if (stopped) {
      process.stdout.write(JSON.stringify({ type: "result", subtype: "error_during_execution", is_error: true, session_id: sessionId, usage: { input_tokens: 30, output_tokens: 0 }, total_cost_usd: 0.001, errors: ["interrupted"] }) + "\n");
      end();
      return;
    }
  }
  delta(CARRY_ON);
  out({ type: "assistant", parent_tool_use_id: null, session_id: sessionId, message: { model, content: [{ type: "text", text: CARRY_ON }] } });
  out({ type: "result", subtype: "success", is_error: false, result: CARRY_ON, num_turns: 1, session_id: sessionId, usage: { input_tokens: 30, output_tokens: 14 }, total_cost_usd: 0.003 });
  end();
}

async function turn(text: string, takenUp = false) {
  if (!takenUp) takeUp(text);
  const initOverride = /INIT:(\S+)/.exec(text)?.[1];
  if (!initSent || initOverride) {
    initSent = true;
    out({ type: "system", subtype: "init", session_id: sessionId, model: initOverride || model, tools: ["Bash"], mcp_servers: [{ name: "crosstalk", status: "connected" }], capabilities, claude_code_version: "2.1.316" });
  }
  // A sign-in that stopped working, in Claude Code's own shapes: its synthetic reply carries the SDK error kind, the
  // result its words. STALE_LOGIN (or a stale start, or a cleared sign-in): a sign-in gone stale. REFRESH_BUSY: another
  // process was renewing it. RESTART_TO_SIGN_IN: 2.1.316's "Restart Claude Code to finish signing in." DISK_FULL: the
  // sign-in couldn't be saved (not a sign-in problem). Each costs nothing: no request leaves. And answers of the API
  // itself, which 2.1.316 words alike for a 401 and a 403: FIRST_PARTY_401 (Anthropic refused the sign-in: stale),
  // FORBIDDEN_403 (the organization is disabled: not a sign-in problem), GATEWAY_401 (a gateway's own token: no
  // api_error_origin, not Claude Code's sign-in).
  type AuthFail = { kind: string; words: string; apiError?: string; status?: number; origin?: string };
  const authFail: AuthFail | null =
    staleRun || authState() === "out" || text.includes("STALE_LOGIN")
      ? { kind: "authentication_failed", words: "Failed to authenticate: OAuth session expired and could not be refreshed" }
      : text.includes("REFRESH_BUSY")
        ? { kind: "server_error", words: "Failed to refresh OAuth token: another Claude Code process is refreshing it or exited mid-refresh. This is usually transient; retry in a minute, and if it persists close other Claude Code processes or sign in again" }
        : text.includes("RESTART_TO_SIGN_IN")
          ? { kind: "invalid_request", words: "Restart Claude Code to finish signing in.", apiError: "stored_login_refused" }
          : text.includes("DISK_FULL")
            ? { kind: "invalid_request", words: "Failed to refresh OAuth token: the disk that holds the Claude Code config directory (~/.claude by default), or your disk quota on it, is full. Delete files you no longer need on that disk and retry; signing in again won't help" }
            : text.includes("FIRST_PARTY_401")
              ? { kind: "authentication_failed", words: 'Failed to authenticate. API Error: 401 {"type":"error","error":{"type":"authentication_error","message":"OAuth token has expired."}}', status: 401, origin: "first_party" }
              : text.includes("FORBIDDEN_403")
                ? { kind: "authentication_failed", words: 'Failed to authenticate. API Error: 403 {"type":"error","error":{"type":"permission_error","message":"This organization has been disabled."}}', status: 403, origin: "first_party" }
                : text.includes("GATEWAY_401")
                  ? { kind: "authentication_failed", words: 'Failed to authenticate. API Error: 401 {"error":{"message":"Authentication Error, Invalid proxy server token passed","type":"auth_error","code":"401"}}', status: 401 }
                  : null;
  const failAuth = (f: AuthFail) => {
    const api = { ...(f.status ? { api_error_status: f.status } : {}), ...(f.origin ? { api_error_origin: f.origin } : {}), ...(f.apiError ? { api_error: f.apiError } : {}) };
    out({ type: "assistant", parent_tool_use_id: null, session_id: sessionId, message: { id: `msg_${Math.random()}`, model: "<synthetic>", role: "assistant", content: [{ type: "text", text: f.words }], usage: { input_tokens: 0, output_tokens: 0 } }, error: f.kind, ...api });
    out({ type: "result", subtype: "success", is_error: true, num_turns: 1, result: f.words, session_id: sessionId, usage: { input_tokens: 0, output_tokens: 0 }, total_cost_usd: 0, ...api });
  };
  if (authFail) return failAuth(authFail);
  if (staleMidwayRun) {
    msgStart();
    delta("Pushing the release.");
    out({ type: "assistant", parent_tool_use_id: null, session_id: sessionId, message: { model, content: [{ type: "text", text: "Pushing the release." }, { type: "tool_use", id: "toolu_push", name: "Bash", input: { command: "git push origin main", description: "Push the release" } }] } });
    out({ type: "user", parent_tool_use_id: null, session_id: sessionId, message: { role: "user", content: [{ type: "tool_result", tool_use_id: "toolu_push", content: "To github.com:example/app.git\n   1a2b3c4..5d6e7f8  main -> main", is_error: false }] } });
    // The next API call needs a fresh token, and it can't be had.
    return failAuth({ kind: "authentication_failed", words: "Failed to authenticate: OAuth session expired and could not be refreshed" });
  }
  if (queueMode && text.includes("LONG_STEP")) {
    msgStart();
    delta("Running the long check.");
    out({ type: "assistant", parent_tool_use_id: null, session_id: sessionId, message: { model, content: [{ type: "text", text: "Running the long check." }, { type: "tool_use", id: "toolu_long", name: "Bash", input: { command: "sleep 600", description: "Wait for the long check" } }] } });
    await new Promise<void>((res) => (stopLong = res));
    stopLong = null;
    if (process.env.FAKE_CLAUDE_STOP_MS) await Bun.sleep(Number(process.env.FAKE_CLAUDE_STOP_MS));
    out({ type: "user", parent_tool_use_id: null, session_id: sessionId, message: { role: "user", content: [{ type: "tool_result", tool_use_id: "toolu_long", content: "Interrupted by user", is_error: true }] } });
    out({ type: "result", subtype: "error_during_execution", is_error: true, session_id: sessionId, usage: { input_tokens: 40, output_tokens: 4 }, total_cost_usd: 0.01, errors: ["interrupted"] });
    return;
  }
  const slow = queueMode ? /SLOW:(\d+)/.exec(text) : null;
  if (slow) {
    msgStart();
    delta("Working on it.");
    await Bun.sleep(Number(slow[1]));
    out({ type: "assistant", parent_tool_use_id: null, session_id: sessionId, message: { model, content: [{ type: "text", text: "Working on it." }] } });
