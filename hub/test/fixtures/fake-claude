        if (process.env.FAKE_CLAUDE_PAID_OUT && /^claude-/.test(name) && name !== FAKE_MODELS[0].resolvedModel) appendFileSync(process.env.FAKE_CLAUDE_PAID_OUT, JSON.stringify({ model: name, max_tokens: 1, messages: [{ role: "user", content: "Hi" }] }) + "\n");
        const m = FAKE_MODELS.find((x) => x.value === msg.request.model);
        if (!m || !FAKE_WINDOWS[m.resolvedModel]) out({ type: "control_response", response: { subtype: "error", request_id: msg.request_id, error: `Model ${msg.request.model} isn't available` } });
        else {
          sizedModel = m.resolvedModel;
          ok();
        }
      } else {
        // A model it has no window for (one not on this plan): no size to give.
        const w = FAKE_WINDOWS[sizedModel];
        ok({ model: sizedModel, ...(w ? { maxTokens: w, rawMaxTokens: w, autoCompactThreshold: w - 33_000 } : {}), isAutoCompactEnabled: true, totalTokens: 15_000, percentage: 1 });
      }
    } else if (msg.type === "user") {
      const text = msg.message.content.map((c: { text?: string }) => c.text ?? "").join("");
      if (process.env.FAKE_CLAUDE_INPUT_OUT) appendFileSync(process.env.FAKE_CLAUDE_INPUT_OUT, JSON.stringify(text) + "\n");
      if (queueMode && busy) {
        if (process.env.FAKE_CLAUDE_TAKE_IN !== "1") queue.push({ uuid: msg.uuid, text });
        continue;
      }
      if (queueMode) void run(text);
      else {
        begin();
        void turn(text).finally(end);
      }
    }
  }
}
