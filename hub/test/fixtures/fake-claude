 * Queue mode: one turn at a time; what was queued meanwhile runs next, in a turn of its own (with FAKE_CLAUDE_WAKE_MS,
 * taken up into the session at once and answered once the API's first words come back). FAKE_CLAUDE_IDLE_BETWEEN=1: the
 * message was still on its way down Claude Code's input as the reply ended, so it said "idle" first, then "running" as it
 * took the message up.
 */
async function run(text: string, takenUp = false) {
  if (!busy) begin();
  busy = true;
  await turn(text, takenUp);
  const next = queue.shift();
  if (next && process.env.FAKE_CLAUDE_IDLE_BETWEEN === "1") {
    end();
    begin();
  }
  if (next && process.env.FAKE_CLAUDE_WAKE_MS) {
    takeUp(next.text);
    await Bun.sleep(wakeMs);
    return void run(next.text, true);
  }
  if (next) return void run(next.text);
  busy = false;
  end();
}

