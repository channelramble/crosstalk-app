{
  "name": "crosstalk",
  "private": true,
  "workspaces": [
    "shared",
    "hub",
    "web",
    "native"
  ],
  "scripts": {
    "dev:hub": "bun run --cwd hub dev",
    "dev:web": "bun run --cwd web dev",
    "build:web": "bun run --cwd web build",
    "build:hub": "bun run --cwd hub build",
    "test": "bun run --cwd hub test && bun run --cwd web test",
    "test:browser": "bun run --cwd web test:browser",
    "e2e": "bun run --cwd hub e2e",
    "typecheck": "bun run --cwd hub typecheck && bun run --cwd web typecheck"
  }
}
